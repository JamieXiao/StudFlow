{
  "short_name": "StudFlow",

  "manifest_version": 3,
  "name": "StudFlow",
  "version": "1.0",
  "description": "Confirm your in the flow while studying with StudFlow. It makes sure you're not asleep or absent for more than a period of time.",
  "action": {
    "default_popup": "index.html",
    "default_title": "StudFlow"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "windows"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}